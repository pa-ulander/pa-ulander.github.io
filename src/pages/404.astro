---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404: Not found" description="Page not found">
  <section class="not-found">
    <div>
      <h1>404</h1>
      <p>PAGE NOT FOUND</p>
      <p>GO BACK <a href="/">HOME</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    width: 100%;
    min-height: calc(100vh - 60px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    background: url('/images/404.jpg') no-repeat center / cover;
  }

  h1,
  p,
  a {
    color: #fff;
    font-weight: 700;
  }

  h1 {
    font-size: 5rem;
    margin-bottom: 1rem;
  }
</style>