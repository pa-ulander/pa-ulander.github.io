---
import { getPosts } from '../posts'
import { getCollection } from 'astro:content'
import BlogPostList from '../components/BlogPostList.astro'
import HomeHero from '../components/HomeHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const home = (await getCollection('pages', ({ data }) =>
  data.published && data.templateKey === 'home-page'))[0]
const posts = await getPosts()

if (!home) throw new Error('Missing published home-page content')

---

<BaseLayout title={home.data.title} description={home.data.description} contentClass="reading-layout">
  <HomeHero />
  <BlogPostList posts={posts} />
</BaseLayout>