---
import { getCollection, render } from 'astro:content'
import BlogPostList from '../components/BlogPostList.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const entries = await getCollection('pages', ({ data }) => data.published)
const home = entries.find(({ data }) => data.templateKey === 'home-page')
const posts = entries
  .filter(({ data }) => data.templateKey === 'blog-post')
  .sort((left, right) => (right.data.date?.getTime() ?? 0) - (left.data.date?.getTime() ?? 0))

if (!home) throw new Error('Missing published home-page content')

const { Content } = await render(home)
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <div class="post-body">
    <Content />
  </div>
  <BlogPostList posts={posts} />
</BaseLayout>