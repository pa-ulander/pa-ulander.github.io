---
import { getPosts } from '../../posts'
import { getCollection, render } from 'astro:content'
import BlogPostList from '../../components/BlogPostList.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

const blog = (await getCollection('pages', ({ data }) =>
  data.published && data.templateKey === 'blog-home'))[0]
const posts = await getPosts()

if (!blog) throw new Error('Missing published blog-home content')

const { Content } = await render(blog)
---

<BaseLayout title={blog.data.title} description={blog.data.description}>
  <header class="page-header blog-intro" data-enter>
    <p class="eyebrow">Blog</p>
    <Content />
  </header>
  <BlogPostList posts={posts} />
</BaseLayout>
