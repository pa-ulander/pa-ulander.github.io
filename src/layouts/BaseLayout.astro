---
import '@fontsource/material-icons'
import '@fontsource/montserrat'
import '@fontsource/nunito'
import '@fontsource/open-sans'
import '@fontsource/roboto'
import '@fontsource/roboto-slab'
import '../css/style.scss'
import '../css/print.scss'
import '../components/HeaderNav/HeaderNav.scss'
import { site } from '../config/site'

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = site.title,
  description = site.description,
  image,
} = Astro.props
const pageTitle = title === site.title ? title : `${title} | ${site.title}`
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const currentPath = Astro.url.pathname
const links = [
  { url: '/', name: 'HOME' },
  { url: '/blog/', name: 'BLOG' },
  { url: '/cv/', name: 'CV' },
]
const isActive = (url: string) =>
  url === '/' ? currentPath === url : currentPath.startsWith(url)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:creator" content={site.social.twitter} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('darkMode')
        const dark = saved === null
          ? matchMedia('(prefers-color-scheme: dark)').matches
          : saved === 'true'
        document.documentElement.classList.add(dark ? 'dark-mode' : 'light-mode')
      })()
    </script>
  </head>
  <body>
    <nav class="nav" aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.url}
              class:list={['navButton', { navButton__active: isActive(link.url) }]}
              aria-current={isActive(link.url) ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        ))}
        <li class="toggler">
          <div class="dark-button">
            <input type="checkbox" id="theme-toggle" aria-label="Toggle dark mode" />
            <label for="theme-toggle"></label>
          </div>
        </li>
      </ul>
      <button class="navprinticon" id="print-page" type="button" title="Skriv ut" aria-label="Skriv ut">
        <span class="material-icons" aria-hidden="true">print</span>
      </button>
    </nav>
    <main class="container">
      <slot />
    </main>
    <script>
      const root = document.documentElement
      const toggle = document.querySelector<HTMLInputElement>('#theme-toggle')
      const isDark = root.classList.contains('dark-mode')

      if (toggle) {
        toggle.checked = isDark
        toggle.addEventListener('change', () => {
          const dark = toggle.checked
          root.classList.toggle('dark-mode', dark)
          root.classList.toggle('light-mode', !dark)
          localStorage.setItem('darkMode', String(dark))
        })
      }

      document.querySelector('#print-page')?.addEventListener('click', () => print())
    </script>
  </body>
</html>