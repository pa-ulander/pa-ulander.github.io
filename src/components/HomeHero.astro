---
import { Image } from 'astro:assets'
import portrait from '../../markdown/cv/img.jpg'
import { site } from '../config/site'
---

<section class="hero" aria-labelledby="hero-title" data-enter>
  <div>
    <p class="eyebrow">PA Ulander · Freelance developer</p>
    <h1 id="hero-title" class="hero-title">
      Web and system development, from first sketch to production.
    </h1>
    <p class="hero-lead">
      I've built web platforms and business systems for more than 20 years.
      I work on my own or alongside your team, and I stay with a project until
      it runs reliably.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={site.social.email}>Hire me</a>
      <a class="button button-secondary" href="/cv/">Read my CV</a>
    </div>
  </div>

  <aside class="hero-card" aria-label="At a glance">
    <Image src={portrait} width={260} alt="Portrait of PA Ulander" loading="eager" />
    <dl class="facts">
      <div><dt>Experience</dt><dd>20+ years of commercial work</dd></div>
      <div><dt>Core stack</dt><dd>Linux, Nginx, PHP, MySQL, JavaScript</dd></div>
      <div><dt>Engagement</dt><dd>Fixed scope or ongoing hours</dd></div>
    </dl>
  </aside>
</section>
