---
import { Image } from 'astro:assets'
import { roleData, type CvRole } from '../../data'
import { site } from '../config/site'
import headerStyles from '../styles/CvHeader.module.scss'
import roleStyles from '../styles/CvRoles.module.scss'
import socialStyles from '../styles/SocialIcons.module.scss'
import Tags from './Tags.astro'

interface Props {
  portrait: ImageMetadata
}

const { portrait } = Astro.props
const {
  current_role: currentRole,
  last_employment: lastEmployment,
  roles_2007_2014: roles2007To2014,
  roles_2000_2007: roles2000To2007,
  additional_clients: additionalClients,
} = roleData
const featuredRoles = [
  {
    ...currentRole,
    summary: `<h4 class="subheading">${currentRole.subheader}</h4>${currentRole.summary}`,
  },
  lastEmployment,
]
const roleSections = [
  { heading: 'Uppdragsgivare 2007-2014', roles: roles2007To2014 },
  {
    heading: 'Uppdragsgivare/genomförda projekt 2000-2007, ett urval',
    roles: roles2000To2007,
  },
]
const getToolTags = (role: CvRole) => role.tooltags ?? []
---

<div class='cv-roles'>
  <section class={roleStyles.page}>
    <header class={headerStyles.cv_header}>
      <div class={headerStyles.row}>
        <div class={headerStyles.cv_header_column1}>
          <Image
            src={portrait}
            width={600}
            alt='PA Ulander - Systemutvecklare & Webbutvecklare'
            class='shadow-lined portrait'
          />
        </div>
        <div class={headerStyles.cv_header_column2}>
          <h1 class={headerStyles.cv_header_heading}>PA Ulander</h1>
          <h2 class={headerStyles.cv_header_subheading}>
            Systemutvecklare & Webbutvecklare
          </h2>
          <p class={headerStyles.cv_header_summary}>
            System och webbutvecklare med drygt 20-års kommersiell erfarenhet
            från utveckling av webb och företagslösningar. Specialiserad på
            välkända opensource teknologier som Linux, Apache/Nginx, PHP, MySQL,
            Javascript, HTML och CSS.
          </p>
          <div class={socialStyles.socialicons}>
            <ul>
              <li>
                <a href={site.social.email} title='Email me'
                  ><span class='material-icons icon'>email</span><span
                    >Mejla</span
                  ></a
                >
              </li>
              <li>
                <a
                  href={site.social.linkedin}
                  title={site.social.linkedin}
                  target='_blank'
                  rel='noopener noreferrer'
                  ><span class='material-icons icon'>work</span><span
                    >LinkedIn</span
                  ></a
                >
              </li>
              <li>
                <a
                  href={site.social.github}
                  title={site.social.github}
                  target='_blank'
                  rel='noopener noreferrer'
                  ><span class='material-icons icon'>code</span><span
                    >Github</span
                  ></a
                >
              </li>
              <li>
                <a href={site.actions.download} title='Hämta CV' download
                  ><span class='material-icons icon'>download</span><span
                    >Hämta CV</span
                  ></a
                >
              </li>
              <li class={socialStyles.headerprinticon}>
                <button class='print-link' type='button' data-print
                  ><span class='material-icons icon'>print</span><span
                    >Skriv ut</span
                  ></button
                >
              </li>
            </ul>
          </div>
          <div class='print-only'>
            <b>Linkedin:</b> linkedin.com/in/paulander <br />
            <b>Github:</b> github.com/pa-ulander <br />
            <b>E-post:</b> pa@kabelkultur.se <br />
          </div>
        </div>
      </div>
    </header>

    <h2 class={roleStyles.experinceheading}>Erfarenheter</h2>
    {
      featuredRoles.map((role) => (
        <>
          <div class={roleStyles.rolecontainer}>
            <div class={roleStyles.roletext}>{role.role}</div>
            <div class={roleStyles.workedfor}>{role.workedfor}</div>
            <div class={roleStyles.period}>{role.period}</div>
            <div class={roleStyles.summary} set:html={role.summary} />
            <div>
              <h4>Verktyg / Teknologier</h4>
              <Tags tags={role.tooltags} />
            </div>
          </div>
          <hr />
        </>
      ))
    }
  </section>

  {
    roleSections.map((section) => (
      <section class={roleStyles.page}>
        <h2 class={roleStyles.heading}>{section.heading}</h2>
        {section.roles.map((role) => (
          <>
            <div class={roleStyles.rolecontainer}>
              <div class={roleStyles.roletext}>{role.role}</div>
              <div class={roleStyles.workedfor}>{role.workedfor}</div>
              {role.period && (
                <div class={roleStyles.period}>{role.period}</div>
              )}
              <div class={roleStyles.summary} set:html={role.summary} />
              <div class='tools' set:html={role.tools} />
              <Tags tags={getToolTags(role)} />
            </div>
            <hr />
          </>
        ))}
      </section>
    ))
  }

  <section class={roleStyles.page}>
    <h2 class={roleStyles.additionalheading}>
      Ytterligare uppdragsgivare 2000-2007
    </h2>
    <div class={roleStyles.additional}>
      {additionalClients.map((client) => <span>{client}</span>)}
    </div>
    <div class={roleStyles.rolesfooter}>
      Fler uppdragsreferenser samt rekommendationer finns på min{' '}
      <a href={site.social.linkedin}>LinkedIn-profil</a>.<br />
      Önskas fler uppdragsreferenser och rekommendationer kan det lämnas på begäran.
    </div>
  </section>
</div>

<script lang='ts'>
  document.querySelectorAll('[data-print]').forEach((button) => {
    button.addEventListener('click', () => print())
  })
</script>

<style>
  .portrait {
    width: 100%;
    height: auto;
    border-radius: 5px;
  }

  .icon {
    display: block;
    font-size: 1.8rem;
  }

  .print-link {
    padding: 0;
    border: 0;
    color: var(--secondary-text-color);
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .print-link:hover {
    color: var(--primary-text-color);
  }
</style>
